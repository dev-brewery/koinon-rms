{
  "mcpServers": {
    "koinon-index": {
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/tools/mcp-servers/codebase-index/server.js"]
    },
    "koinon-dev": {
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/tools/mcp-koinon-dev/dist/index.js"]
    },
