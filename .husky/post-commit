#!/bin/sh
# Post-commit: incrementally reindex the commit's changed files into the RAG
# vector index (koinon-code) so it never drifts stale. Runs asynchronously and
# never blocks or fails git. This is the drift-preventer: the index stays
# current on every commit without anyone waiting on a full reindex.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
PY="$ROOT/tools/rag/venv-rag/bin/python"
[ -x "$PY" ] || exit 0
[ -f "$ROOT/tools/rag/reindex-changes.py" ] || exit 0
nohup "$PY" "$ROOT/tools/rag/reindex-changes.py" \
  >> "$ROOT/tools/rag/reindex-incremental.log" 2>&1 &
exit 0
