# =============================================================================
# Koinon RMS .gitignore
# =============================================================================

# =============================================================================
# .NET / C#
# =============================================================================
bin/
obj/
out/
.vs/
.vscode/
*.user
*.userosscache
*.sln.docstates
*.suo
*.cache
*.dll
*.exe
*.pdb
*.mdf
*.ldf

# User-specific files
*.rsuser
*.userprefs

# NuGet
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# .NET Core
.dotnet/
.nuget/

# Local secrets
secrets.json
appsettings.*.local.json
appsettings.Local.json

# =============================================================================
# Node.js / React
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# MCP Servers (project-local dependencies)
tools/mcp-servers/node_modules/
tools/token-optimizer-mcp/

# Build output
dist/
build/
# koinon-dev MCP server ships its build so a fresh clone works with zero steps
# (CI drift check rebuilds and diffs it)
!tools/mcp-koinon-dev/dist/
!tools/mcp-koinon-dev/dist/**

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.devenv

# Gemini Context Tools
tools/gemini-context/.env
tools/gemini-context/venv_gemini/
venv_gemini/

# Python testing
.venv/
venv/
*.pyc
__pycache__/
.pytest_cache/
htmlcov/
.coverage

# RAG system
tools/rag/.venv/
tools/rag/__pycache__/
tools/rag/**/__pycache__/

# Vite
*.local

# =============================================================================
# IDE / Editor
# =============================================================================
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# =============================================================================
# OS Generated
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# =============================================================================
# Docker
# =============================================================================
# Local-only compose overrides. The shared compose files (dev/full/test/ci/rag)
# ARE committed — a gitignore rule never stopped edits to tracked files anyway,
# it only silently swallowed legitimate new compose files.
docker-compose.override.yml

# =============================================================================
# Testing
# =============================================================================
coverage/
*.coverage
*.coveragexml
TestResults/
.ncrunchsolution
.ncrunchproject
src/web/test-debug/

# =============================================================================
# Logs
# =============================================================================
logs/
*.log
log.txt

# =============================================================================
# Database
# =============================================================================
*.db
*.db-journal
*.sqlite

# =============================================================================
# Certificates
# =============================================================================
*.pfx
*.pem
*.key
*.crt
*.cer

# =============================================================================
# Project Specific
# =============================================================================
# Reference codebase (read-only, for development reference)
reference/$

# Data migration exports
tools/migration/exports/
tools/migration/output/

# Temporary files
tmp/
temp/
.temp/

# =============================================================================
# Backup Files
# =============================================================================
*.bak
*.backup
*~

# =============================================================================
# Agent Infrastructure (Synced to Nextcloud)
# =============================================================================
# These folders are not committed to the repo but synced separately
# See .git-sync/ for sync configuration
# Exception: agents/ and skills/ are portable project tooling and ARE
# committed so a clone exports them to other machines. settings.json is
# committed so the PreToolUse enforcement hooks bind every clone.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/settings.json
.git-sync/

# GitHub - all files (prevent agent CI modifications)
#.github/

# Claude Code temporary files
tmp/validate-output.log

# .mcp.json IS committed: it's Claude Code's project-scoped MCP config and
# must export with a clone (relative paths/npx only, dev-default creds that
# match the committed compose files — no real secrets; see ADR 0005).

# Change Orders and Requests
docs/change-orders/
test-results/.last-run.json

venv-rag/

.kilocode/
.kiloignore
.continue/mcpServers/code-rag.yaml
