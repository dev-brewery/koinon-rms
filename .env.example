# Koinon RMS Development Environment Configuration
# Copy this file to .env and customize for your local environment
# This file should NOT be committed to version control with secrets

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=koinon
POSTGRES_PASSWORD=koinon
POSTGRES_DB=koinon
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Connection string (for use by .NET applications)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=koinon;Username=koinon;Password=koinon

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
ConnectionStrings__Redis=localhost:6379

# =============================================================================
# JWT Configuration
# =============================================================================
Jwt__Secret=development-secret-key-at-least-32-characters-long-for-dev-only
Jwt__Issuer=koinon
Jwt__Audience=koinon
Jwt__ExpiryMinutes=60

# =============================================================================
# API Configuration
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_HTTPS_PORT=8443

# =============================================================================
# Frontend Configuration
# =============================================================================
VITE_API_BASE_URL=http://localhost:5000
VITE_API_V1_URL=http://localhost:5000/api/v1

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=Koinon RMS
APP_VERSION=0.1.0
ENVIRONMENT=development

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=Information
SERILOG_MIN_LEVEL=Information

# =============================================================================
# RAG semantic search (see docs/claude/mcp-tools.md)
# Everything defaults to the team inference server — no localhost services.
# Override only for exceptional setups; never point these at localhost in
# committed config.
# =============================================================================
#RAG_HOST=192.168.1.225
#QDRANT_URL=http://192.168.1.225:6333
#EMBEDDINGS_URL=http://192.168.1.225:4000

## Architect Review Brain ##
# Primary path: the Claude Code handoff wrapper invokes Codex through the
# installed Codex bridge/plugin. ChatGPT Plus/Pro usage is not a Platform API
# key; do not configure ARCHITECT_API_KEY for Plus subscription access.
ARCHITECT_PROVIDER=codex
#ARCHITECT_CODEX_BIN=codex
#ARCHITECT_CODEX_MODEL=gpt-5.5
#ARCHITECT_CODEX_PROFILE=
#ARCHITECT_CODEX_HOME=C:\Users\<codex-host-user>\.codex
ARCHITECT_TIMEOUT_MS=600000

# Optional fallback when Codex is unavailable. Both Codex and fallback down
# means the change halts; do not proceed without an architect ruling.
#ARCHITECT_FALLBACK_URL=http://192.168.1.225:4000/v1
#ARCHITECT_FALLBACK_MODEL=qwen36-dense
